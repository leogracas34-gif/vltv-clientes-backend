# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" de verdade pro GitHub (adicione no .gitignore).

# ── API (usada pelo app Android pra pedir o envio de mensagens) ─────────
# Gere uma chave aleatoria longa, ex: openssl rand -hex 32
API_KEY=troque_esta_chave_por_uma_bem_grande_e_aleatoria
API_PORT=3300

# ── Telegram (so usado pra te mandar o QR code do WhatsApp de forma facil) ─
TELEGRAM_BOT_TOKEN=coloque_o_token_do_seu_bot_aqui
TELEGRAM_CHAT_ID=coloque_seu_chat_id_aqui

# ── TMDB (busca de posters de filmes/series pro Gerador de Banner do app) ─
# Gratis: crie uma conta em themoviedb.org > Configuracoes > API > gere uma
# "API Key (v3 auth)".
TMDB_API_KEY=coloque_sua_api_key_v3_do_tmdb_aqui
